# Flask core
SECRET_KEY=change-me-to-a-long-random-string-in-production
FLASK_CONFIG=development
FLASK_APP=wsgi.py

# Database
# SQLite (development default — leave blank to use instance/quiz.db)
DATABASE_URL=sqlite:///quiz.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/quiz_db

# Registration control
REGISTRATION_ENABLED=true

# Upload limits
MAX_CONTENT_LENGTH=10485760

# Test display
TOPIC_VISIBLE_DURING_TEST=true

# Time limits (minutes)
MIN_TIME_LIMIT_MINUTES=1
MAX_TIME_LIMIT_MINUTES=480

# Adaptive test settings
MIN_ADAPTIVE_ATTEMPTS=10
ADAPTIVE_RECENT_ATTEMPTS=30
ADAPTIVE_STRENGTH=1.5
ADAPTIVE_MAX_TOPIC_SHARE=0.5

# Staged import expiry
STAGED_IMPORT_EXPIRY_MINUTES=60
